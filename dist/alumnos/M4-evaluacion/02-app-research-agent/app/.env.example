# Copiá este archivo a `.env` en esta misma carpeta (app/) y completá los valores.

# --- Claves ---
OPENAI_API_KEY=sk-...
# Opcional. Si falta, el agente usa Wikipedia en lugar de la búsqueda web y lo avisa.
TAVILY_API_KEY=tvly-...

# --- Modelos (mismos nombres que el .env de la raíz del material) ---
MODEL_CHEAP=gpt-4.1-mini     # research, writer, editor
MODEL_STRONG=gpt-4.1         # planner

# --- Base de datos ---
# Sin Docker (lo más simple para la clase): un archivo sqlite en esta carpeta
DATABASE_URL=sqlite:///./tasks.db
# Con Docker: el entrypoint la define solo, no hace falta ponerla acá.
# Con un Postgres externo: DATABASE_URL=postgresql://usuario:clave@host:5432/basededatos

# --- Opcionales ---
# RESET_DB=1          # borra las tablas al arrancar (el original lo hacía siempre)
# ARXIV_FETCH_PDF=0   # no descargar PDFs de arXiv (el paso de research es mucho más rápido)
