# Copiá este archivo a `.env` (en la raíz del material) y completá los valores.
# Los notebooks lo cargan con load_dotenv(find_dotenv(usecwd=True)).

# --- Claves ---
OPENAI_API_KEY=sk-...
# Solo para los labs que buscan en la web (M3 research agent, M4, M5 equipo de investigación).
# Si falta, esos labs usan Wikipedia/arXiv como fallback.
TAVILY_API_KEY=tvly-...

# --- Modelos (ver README → "Modelos y fecha de caducidad") ---
# Barato: generación, tools, ruteo.       Fuerte: reflexión, crítica, visión.
MODEL_CHEAP=gpt-4.1-mini
MODEL_STRONG=gpt-4.1

# --- M3 · Email assistant ---
M3_EMAIL_SERVER_API_URL=http://localhost:8000
